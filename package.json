{
  "name": "n8n-nodes-sigmora",
  "version": "0.2.0",
  "description": "n8n community nodes for Sigmora media automation.",
  "license": "MIT",
  "homepage": "https://sigmora.org",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "sigmora",
    "video",
    "automation"
  ],
  "author": { "name": "Sigmora", "email": "support@sigmora.org" },
  "repository": {
    "type": "git",
    "url": "https://github.com/mlsniperpro/n8n-nodes-sigmora.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "test": "npm run build && node --test test/*.test.cjs",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": ["dist", "templates", "README.md", "LICENSE.md"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": ["dist/credentials/SigmoraApi.credentials.js"],
    "nodes": [
      "dist/nodes/Sigmora/Sigmora.node.js",
      "dist/nodes/Sigmora/SigmoraTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.53.1",
    "n8n-workflow": "*",
    "eslint": "9.39.5",
    "release-it": "^19.0.4",
    "typescript": "5.9.3"
  },
  "peerDependencies": { "n8n-workflow": "*" },
  "engines": { "node": ">=22" }
}
