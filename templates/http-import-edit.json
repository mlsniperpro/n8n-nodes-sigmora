{
  "name": "Sigmora HTTP — import and start footage edit",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Run workflow",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "http-asset-ready-condition",
              "leftValue": "={{$json.ready === true || ($json.asset?.status === 'ready' && $json.asset?.ingestStatus === 'active')}}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "http-asset-ready",
      "name": "Asset ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "http-asset-retryable-condition",
              "leftValue": "={{$json.retryable === true || $json.asset?.status === 'processing' || $json.asset?.ingestStatus === 'pending'}}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "http-asset-retryable",
      "name": "Asset still processing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [700, 120]
    },
    {
      "parameters": { "amount": 30, "unit": "seconds" },
      "id": "http-wait-for-ingest",
      "name": "Wait for ingest",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [920, 80]
    },
    {
      "parameters": {
        "url": "={{'https://api.sigmora.org/v1/assets/' + encodeURIComponent($('Import media over HTTP').item.json.asset.id) + '/ingest?projectId=' + encodeURIComponent($('Import media over HTTP').item.json.projectId)}}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "={{'Bearer ' + $env.SIGMORA_API_KEY}}" }
        ] },
        "options": {}
      },
      "id": "http-ingest-status",
      "name": "Get ingest status over HTTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 80]
    },
    {
      "parameters": {
        "errorMessage": "Sigmora could not make the imported asset ready for editing."
      },
      "id": "http-ingest-failed",
      "name": "Stop on ingest failure",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [920, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.sigmora.org/v1/assets/import",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "={{'Bearer ' + $env.SIGMORA_API_KEY}}" },
          { "name": "Idempotency-Key", "value": "={{'import:' + $execution.id}}" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"projectId\":\"prj_replace_me\",\"sourceUrl\":\"https://cdn.example.com/recording.mp4\",\"platform\":\"youtube\"}",
        "options": {}
      },
      "id": "http-import",
      "name": "Import media over HTTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.sigmora.org/v1/video/edit",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "={{'Bearer ' + $env.SIGMORA_API_KEY}}" },
          { "name": "Idempotency-Key", "value": "={{'edit:' + $('Import media over HTTP').item.json.asset.id}}" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ projectId: $('Import media over HTTP').item.json.projectId, shootId: $('Import media over HTTP').item.json.asset.id, clipIds: [$json.contentId || $json.asset.contentId], title: $('Import media over HTTP').item.json.asset.title, makeLong: true, shortsCount: 0, reviewCuts: false }) }}",
        "options": {}
      },
      "id": "http-edit",
      "name": "Start footage edit over HTTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, -80]
    }
  ],
  "connections": {
    "Run workflow": { "main": [[{ "node": "Import media over HTTP", "type": "main", "index": 0 }]] },
    "Import media over HTTP": { "main": [[{ "node": "Asset ready?", "type": "main", "index": 0 }]] },
    "Asset ready?": {
      "main": [
        [{ "node": "Start footage edit over HTTP", "type": "main", "index": 0 }],
        [{ "node": "Asset still processing?", "type": "main", "index": 0 }]
      ]
    },
    "Asset still processing?": {
      "main": [
        [{ "node": "Wait for ingest", "type": "main", "index": 0 }],
        [{ "node": "Stop on ingest failure", "type": "main", "index": 0 }]
      ]
    },
    "Wait for ingest": { "main": [[{ "node": "Get ingest status over HTTP", "type": "main", "index": 0 }]] },
    "Get ingest status over HTTP": { "main": [[{ "node": "Asset ready?", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {}
}
